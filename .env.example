# Copy to .env.local for local work, or add these as Environment Variables in Vercel (Project > Settings).
# Every one is optional: leave it out and the site falls back gracefully.

# Clinic number, international format, no + or spaces. Turns on Call buttons.
VITE_CLINIC_PHONE=
# WhatsApp number (same format). The booking form then opens WhatsApp with the request pre-written.
VITE_CLINIC_WHATSAPP=
# Formspree (or compatible) form URL, e.g. https://formspree.io/f/xxxxxxxx
# Booking requests then land in the clinic's email inbox and the patient sees a confirmation screen.
VITE_BOOKING_ENDPOINT=
# Google Calendar appointment schedule or Cal.com link. Adds a "See live availability" button.
VITE_SCHEDULE_URL=

# ── Live booking + Avighna Desk (see SETUP.md) ──
# Added automatically when you connect Upstash Redis in Vercel (Storage tab):
#   KV_REST_API_URL, KV_REST_API_TOKEN
# Required: at least 10 characters, only the doctor knows it.
DESK_PASSPHRASE=
# Recommended: the final web address, e.g. https://avighna-clinic.in (Face ID is tied to it)
DESK_ORIGIN=
# Optional "new booking" alerts: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
CLINIC_ADDRESS=
# Free Cloudflare Turnstile bot check on the booking form (see SETUP.md). Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
